# =============================================================================
# DRAGME PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Database Configuration (PostgreSQL / SQLite fallback)
# - Neon.tech / Supabase: postgres://username:password@ep-cool-cloud.us-east-2.aws.neon.tech/dragmedb?sslmode=require
# - Local PostgreSQL: postgres://postgres:postgres@localhost:5432/dragme_database
DATABASE_URL=
PORT=5173
JWT_SECRET=dragme_super_secret_production_key_2026_jwt_token_scale
NODE_ENV=development

# Storage Provider Configuration
# Supported: 'local' | 's3' | 'r2' | 'gcs'
STORAGE_PROVIDER=local
S3_BUCKET_NAME=dragme-media-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CDN & Delivery URL (Optional, leave blank for local relative path)
CDN_BASE_URL=

# Media Processing Concurrency
MEDIA_WORKER_CONCURRENCY=4
